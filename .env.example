# MongoDB Atlas connection string (database name is set separately below)
MONGODB_URI=
MONGODB_DB=noor_e_durood

# Secret salt used to hash visitor IPs (long random string)
IP_HASH_SALT=

# Admin panel password: a bcrypt hash from `npm run admin:hash` (recommended)
# or plain text. In this file write each $ in a hash as \$ (Next expands $VARS).
ADMIN_PASSWORD=

# Public URL of the site, used for share links and metadata
NEXT_PUBLIC_SITE_URL=
